# Environment variables for the live QPay sandbox integration tests.
#
# You do NOT need this file to run the tests. Leave everything unset and the
# suite uses QPay's public sandbox merchant, which is published in QPay's own
# documentation and is the same account `QPaySettings.sandbox()` defaults to.
# That is deliberate: the package should work on a fresh clone with no setup.
#
# Set these only to test against your OWN sandbox merchant. Nothing auto-loads
# this file -- there is no python-dotenv dependency. Copy it to `.env` and pass
# it explicitly:
#
#     cp .env.example .env
#     uv run --env-file .env pytest -m integration
#
# `.env` is gitignored; `.env.example` is not. Never put real credentials here.

# Opt in to tests that make live requests. Without this they are skipped.
QPAY_RUN_LIVE_TESTS=1

# Your own sandbox merchant. Unset = the shared public one (you will be warned).
QPAY_USERNAME=TEST_MERCHANT
QPAY_PASSWORD=123456
QPAY_INVOICE_CODE=TEST_INVOICE
